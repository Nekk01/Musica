@page "/Profile/{id:int?}"
@using Microsoft.AspNetCore.Mvc.RazorPages
@inject IProfileService ProfileService

<PageTitle>Profile</PageTitle>

<div class="profile-header">
    <div class="profile-details">
        <img src="@user.avatar_url" alt="Алиса Волкова" class="profile-avatar-large">
        <h1>@user.display_name</h1>

        <p>@user.bio</p>

        @* <div class="stats">
            <div class="stat-item"><span>284</span><span class="stat-label"> Плейлиста</span></div>
            <div class="stat-item"><span>1.2k</span><span class="stat-label"> Подписчики</span></div>
            <div class="stat-item"><span>89</span><span class="stat-label"> Подписки</span></div>
        </div> *@
    </div>
</div>

<h2>История</h2>
<div class="mini-card-container">
    <div class="music-mini-card">
        <img src="https://picsum.photos/id/104/300/300" alt="Обложка альбома" class="album-thumb-max">
        <span class="track-title">Midnight Echoes</span>
        <span class="artist-name">Lunar Drift</span>
    </div>
    <div class="music-mini-card">
        <img src="https://picsum.photos/id/122/300/300" alt="Обложка" class="album-thumb-max">
        <span class="track-title">Golden Hour</span>
        <span class="artist-name">Sasha Vega</span>
    </div>
    <div class="music-mini-card">
        <img src="https://picsum.photos/id/155/300/300" alt="Обложка" class="album-thumb-max">
        <span class="track-title">Neon Lights</span>
        <span class="artist-name">The Spectra</span>
    </div>
    <div class="music-mini-card">
        <img src="https://picsum.photos/id/182/300/300" alt="Обложка" class="album-thumb-max">
        <span class="track-title">Волны</span>
        <span class="artist-name">Анна Полева</span>
    </div>
    <div class="music-mini-card">
        <img src="https://picsum.photos/id/160/300/300" alt="Обложка" class="album-thumb-max">
        <span class="track-title">Stellar</span>
        <span class="artist-name">Nova</span>
    </div>
</div>

@code{
    [Parameter]
    public int id{ get; set;}
    UserModel user { get; set;} = new();
    protected override async Task OnInitializedAsync()
    {
        user = await ProfileService.FindByID(id);
    }
}