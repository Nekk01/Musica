@page "/Home"

<PageTitle>Home</PageTitle>

<section class="content-section">
    <h2>New Releases</h2>
    <div class="mini-card-container">
        @for(int a = 0; a <=5; a++){
            <div class="music-mini-card" onclick="openTrackView(this)">
                <img src="Images/card.jpg" alt="Crawling" class="album-thumb-max">
                <div class="text-meta">
                    <span class="track-title">Crawling</span>
                    <span class="artist-name">White Bat</span>
                </div>
            </div>
        }
    </div>
</section>

<section class="content-section">
    <h2>Recommended for you</h2>
    <div class="mini-card-container">
        @for(int a = 0; a <=3; a++){
            <div class="music-mini-card" onclick="openTrackView(this)">
                <img src="Images/card.jpg" alt="Crawling" class="album-thumb-max">
                <div class="text-meta">
                    <span class="track-title">Crawling</span>
                    <span class="artist-name">White Bat</span>
                </div>
            </div>
        }
    </div>
</section>