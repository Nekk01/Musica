@page "/Home"
@inject ITrackService TrackService

<PageTitle>Home</PageTitle>

<section class="content-section">
    <h2>New Releases</h2>
    <div class="mini-card-container">
        @foreach(var item in items){
            <div class="music-mini-card" 
                 data-file-url="@item.file_url"
                 data-title="@item.title"
                 data-artist="@item.artist_name"
                 data-cover="@item.cover_url"
                 onclick="openTrackView(this)">
                <img src="@item.cover_url" alt="@item.title" class="album-thumb-max">
                <div class="text-meta">
                    <span class="track-title">@item.title</span>
                    <span class="artist-name">@item.artist_name</span>
                </div>
            </div>
        }
    </div>
</section>

<section class="content-section">
    <h2>Recommended for you</h2>
    <div class="mini-card-container">
        @for(int a = 0; a <=3; a++){
            <div class="music-mini-card" onclick="openTrackView(this)">
                <img src="Images/card.jpg" alt="Crawling" class="album-thumb-max">
                <div class="text-meta">
                    <span class="track-title">Crawling</span>
                    <span class="artist-name">White Bat</span>
                </div>
            </div>
        }
    </div>
</section>

@code{
    public List<TrackModel> items = new();

    protected override async Task OnInitializedAsync()
    {
        items = await TrackService.GetAllRecords();
    }
}