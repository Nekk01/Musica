@page "/Home"
@rendermode InteractiveServer
@inject ITrackService TrackService
@inject IPlaylistService PlaylistService
@inject SyncSelectedTrackService SSTS

<PageTitle>Home</PageTitle>

<section class="content-section">
    <h2>New Releases</h2>
    <div class="mini-card-container">
        @foreach(var item in items){
            <div class="music-mini-card" data-file-url="@item.file_url" data-title="@item.title" data-artist="@item.artist_name" data-cover="@item.cover_url" @onclick="() => ChangeID(item)">
                <img src="@item.cover_url" alt="@item.title" class="album-thumb-max">
                <div class="text-meta">
                    <span class="track-title">@item.title</span>
                    <span class="artist-name">@item.artist_name</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    public List<TrackModel> items = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await TrackService.GetAllRecords();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
        }
    }

    public void ChangeID(TrackModel track)
    {
        SSTS.ChangeID(track);
    }
}