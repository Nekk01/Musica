@page "/Login"
@using Musica.Components.Layout
@using System.Security.Claims
@layout TestLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
<div class="center">
    <div class="form-container">
        <h1>Авторизация</h1>
        <EditForm method="post" Model="Model" FormName="registerForm" OnValidSubmit="AuthenticateUser">
            <div class="form-group">
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <InputText class="form-input" type="text" placeholder="Почта" name="Model.Email" @bind-value="Model.Email"/>
                </div>
            </div>

            <div class="form-group">
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <InputText class="form-input" type="password" placeholder="Пароль" name="Model.Password" @bind-value="Model.Password"/>
                </div>
            </div>
            <button type="submit" class="button">Войти</button>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginModel Model { get; set; } = new LoginModel();

    private async Task AuthenticateUser()
    {
        if (HttpContext == null) return;

        var principal = await AuthService.AuthenticateUser(Model.Email, Model.Password);

        if (principal != null)
        {
            await HttpContext.SignInAsync("Cookie", principal);
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }
}