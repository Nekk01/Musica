@using System.Collections
@rendermode InteractiveServer
@inject SyncSelectedTrackService SSTS
@inject IJSRuntime JS
@implements IAsyncDisposable

<footer class="media-player">

    <div class="progress-container">
        <input type="range" 
               class="progress-slider" 
               id="progress-slider" 
               min="0" 
               max="1000" 
               value="@sliderValue"
               @onchange="OnSliderChange" 
               disabled="@(track == null)" />
    </div>

    <audio @ref="audioElement" id="audioElement" preload="metadata"></audio>

    <div class="controls-row">
        @if (track != null)
        {
            <div style="font-size: 12px; color: gray;">
                <span>@FormatTime(currentSeconds) / @FormatTime(trackLength)</span>
            </div>

            <div class="track-info">
                <img src="@track.cover_url" alt="Album Art" class="album-thumb" id="album-art" />
                <div class="text-meta">
                    <span class="track-title" id="track-title">@track.title</span>
                    <span class="artist-name" id="artist-name">@track.artist_name</span>
                </div>
            </div>
        }
        else
        {
            <div class="track-info">
                <img src="/Images/default-cover.png" alt="Album Art" class="album-thumb" id="album-art" />
                <div class="text-meta">
                    <span class="track-title" id="track-title">-</span>
                    <span class="artist-name" id="artist-name">-</span>
                </div>
            </div>
        }

        <div class="playback-controls">
            <button class="icon-btn" id="prev-btn">⏮</button>
            <button class="play-pause-btn" id="play-pause-btn" @onclick="TogglePlayPause" disabled="@(track == null)">
                @(isPlaying ? "⏸" : "▶")
            </button>
            <button class="icon-btn" id="next-btn">⏭</button>
        </div>

        <div class="extra-controls">
            <button class="icon-btn" id="settings-btn">
                <span class="material-symbols-outlined">settings</span>
            </button>
            <button class="icon-btn" id="playlist-btn">
                <span class="material-symbols-outlined">playlist_add</span>
            </button>
            <button class="icon-btn" id="volume-btn">
                <span class="material-symbols-outlined">volume_down</span>
            </button>
            <button class="icon-btn" id="favorite-btn">
                <span class="material-symbols-outlined">favorite</span>
            </button>
        </div>
    </div>
</footer>

@code {
    private ElementReference audioElement;
    private DotNetObjectReference<Player>? dotNetRef;

    public TrackModel? track;
    private bool isPlaying = false;
    private bool isJsInitialized = false;
    private string? pendingTrackUrl = null;

    private double trackLength = 0;
    private double currentSeconds = 0;
    private int sliderValue = 0;

    protected override void OnInitialized()
    {
        SSTS.onIDChanged += OnTrackSelected;
        if (SSTS.track != null)
        {
            track = SSTS.track;
            pendingTrackUrl = track.file_url;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);

            await InitializeJsPlayerAsync();
            isJsInitialized = true;

            if (!string.IsNullOrEmpty(pendingTrackUrl))
            {
                var url = pendingTrackUrl;
                pendingTrackUrl = null;
                await LoadAndPlayTrackAsync(url);
            }
        }
    }

    private async Task InitializeJsPlayerAsync()
    {
        string jsCode = @"
            window.blazorAudio = {
                init: function(audioEl, dotnetHelper) {
                    if (!audioEl) return;
                    audioEl._dotnet = dotnetHelper;

                    const sendDuration = () => {
                        console.log('Raw audioEl.duration:', audioEl.duration);
                        if (Number.isFinite(audioEl.duration) && audioEl.duration > 0) {
                            dotnetHelper.invokeMethodAsync('OnDurationChanged', audioEl.duration);
                        }
                    };

                    audioEl.onloadedmetadata = sendDuration;
                    audioEl.ondurationchange = sendDuration;

                    audioEl.ontimeupdate = () => {
                        const dur = Number.isFinite(audioEl.duration) ? audioEl.duration : 0;
                        dotnetHelper.invokeMethodAsync('OnTimeUpdate', audioEl.currentTime, dur);
                    };

                    audioEl.onended = () => {
                        dotnetHelper.invokeMethodAsync('OnTrackEnded');
                    };
                },
                loadAndPlay: async function(audioEl, url) {
                    if (!audioEl) return false;
                    audioEl.pause();
                    audioEl.src = url;
                    audioEl.load();

                    this.fetchExactDuration(url, audioEl._dotnet);

                    try {
                        await audioEl.play();
                        return true;
                    } catch (err) {
                        console.warn('Ошибка запуска:', err);
                        return false;
                    }
                },
                fetchExactDuration: async function(url, dotnetHelper) {
                    try {
                        const response = await fetch(url);
                        const arrayBuffer = await response.arrayBuffer();
                        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                        const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
                        
                        console.log('Длительность', audioBuffer.duration);
                        if (dotnetHelper && audioBuffer.duration > 0) {
                            dotnetHelper.invokeMethodAsync('OnDurationChanged', audioBuffer.duration);
                        }
                        audioCtx.close();
                    } catch (e) {
                        console.error('Не удалось декодировать длительность', e);
                    }
                },
                play: async function(audioEl) {
                    if (!audioEl) return false;
                    try {
                        await audioEl.play();
                        return true;
                    } catch (e) {
                        return false;
                    }
                },
                pause: function(audioEl) {
                    if (audioEl) audioEl.pause();
                },
                seek: function(audioEl, timeSeconds) {
                    if (audioEl && Number.isFinite(timeSeconds)) {
                        audioEl.currentTime = timeSeconds;
                    }
                }
            };
        ";

        await JS.InvokeVoidAsync("eval", jsCode);
        await JS.InvokeVoidAsync("blazorAudio.init", audioElement, dotNetRef);
    }

    private async void OnTrackSelected(TrackModel newTrack)
    {
        await InvokeAsync(async () =>
        {
            track = newTrack;
            trackLength = 0;
            currentSeconds = 0;
            sliderValue = 0;
            StateHasChanged();

            if (isJsInitialized && track != null)
            {
                await LoadAndPlayTrackAsync(track.file_url);
            }
            else if (track != null)
            {
                pendingTrackUrl = track.file_url;
            }
        });
    }

    private async Task LoadAndPlayTrackAsync(string url)
    {
        isPlaying = await JS.InvokeAsync<bool>("blazorAudio.loadAndPlay", audioElement, url);
        StateHasChanged();
    }

    private async Task TogglePlayPause()
    {
        if (track == null) return;

        if (isPlaying)
        {
            await JS.InvokeVoidAsync("blazorAudio.pause", audioElement);
            isPlaying = false;
        }
        else
        {
            isPlaying = await JS.InvokeAsync<bool>("blazorAudio.play", audioElement);
        }
    }

    private async Task OnSliderChange(ChangeEventArgs e)
    {
        if (trackLength <= 0) return;

        if (int.TryParse(e.Value?.ToString(), out int newSliderPos))
        {
            sliderValue = newSliderPos;
            double targetSeconds = (sliderValue / 1000.0) * trackLength;
            currentSeconds = targetSeconds;

            await JS.InvokeVoidAsync("blazorAudio.seek", audioElement, targetSeconds);
        }
    }

    [JSInvokable]
    public void OnDurationChanged(double duration)
    {
        trackLength = duration;
        Console.WriteLine($"Получена длительность трека: {trackLength} сек.");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnTimeUpdate(double currentTime, double duration)
    {
        currentSeconds = currentTime;

        if (duration > 0 && trackLength == 0)
        {
            trackLength = duration;
        }

        if (trackLength > 0)
        {
            sliderValue = (int)((currentSeconds / trackLength) * 1000.0);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnTrackEnded()
    {
        isPlaying = false;
        sliderValue = 0;
        currentSeconds = 0;
        StateHasChanged();
    }

    private string FormatTime(double totalSeconds)
    {
        if (totalSeconds <= 0 || double.IsNaN(totalSeconds)) return "00:00";
        var ts = TimeSpan.FromSeconds(totalSeconds);
        return ts.ToString(@"mm\:ss");
    }

    public ValueTask DisposeAsync()
    {
        SSTS.onIDChanged -= OnTrackSelected;
        dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}