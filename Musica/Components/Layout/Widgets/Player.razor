@using System.Collections
@using System.Timers
@rendermode InteractiveServer
@inject SyncSelectedTrackService SSTS
@inject IJSRuntime JS


<footer class="media-player">

    <div class="progress-container">
        <input type="range" class="progress-slider" id="progress-slider" @onchange="Rewind" min="0" max="1000" value="@currentTimeStamp">
    </div>

    <div class="controls-row">
        @if (track != null)
        {
            <p>@currentTimeStamp</p>
            <p>@trackLength</p>
            <p>@calculatedRewind</p>
            <audio @ref="audioElement" id="audioElement" preload="auto" src="@track.file_url"></audio>
            <div class="track-info">
                <img src="@track.cover_url" alt="Album Art" class="album-thumb" id="album-art">
                <div class="text-meta">
                    <span class="track-title" id="track-title">@track.title</span>
                    <span class="artist-name" id="artist-name">@track.artist_name</span>
                </div>
            </div>
        }
        else
        {
            <div class="track-info">
                <img src="/Images/default-cover.png" alt="Album Art" class="album-thumb" id="album-art">
                <div class="text-meta">
                    <span class="track-title" id="track-title">title</span>
                    <span class="artist-name" id="artist-name">artist_name</span>
                </div>
            </div>
        }

        <div class="playback-controls">
            <button class="icon-btn" id="prev-btn">⏮</button>
            <button class="play-pause-btn" id="play-pause-btn" @onclick="PlayingStates">@playPauseLabel</button>
            <button class="icon-btn" id="next-btn">⏭</button>
        </div>

        <div class="extra-controls">
            <button class="icon-btn" id="settings-btn">
                <span class="material-symbols-outlined">settings</span>
            </button>
            <button class="icon-btn" id="playlist-btn">
                <span class="material-symbols-outlined">playlist_add</span>
            </button>
            <button class="icon-btn" id="volume-btn">
                <span class="material-symbols-outlined">volume_down</span>
            </button>
            <button class="icon-btn" id="favorite-btn">
                <span class="material-symbols-outlined">favorite</span>
            </button>
        </div>
    </div>
</footer>

<script>
    window.audioPlayer = 
    {
        play: function (element)
        {
            element.play();
        },

        pause: function (element)
        {
            element.pause();
        },

        startover: function (element, time)
        {
            element.currentTime = time ;
        },

        getlength: function (element)
        {
            console.log(element.duration)
            return element.duration;
        },

        getcurrenttime: function (element)
        {
            return element.currentTime;
        }
    }
</script>

@code{
    string playPauseLabel = "▶";
    bool isPlaying = false;

    double trackLength = 0;
    double currentTimeStamp = 0;
    double calculatedRewind;

    public TrackModel track;
    private ElementReference audioElement;

    Timer timer = new Timer(1000);

    protected override void OnInitialized()
    {
        SSTS.onIDChanged += OnPlayerIdChanged;
        track = SSTS.track;

        timer.Elapsed += TimerGetCurrentTimeStamp;
    }

    //Изменение ID трека
    private void OnPlayerIdChanged(TrackModel newTrack)
    {
        track = newTrack;
        Console.WriteLine($"track ID - {track.ID}");

        StartOver();

        InvokeAsync(StateHasChanged);
    }

    //Изменение состояния проигрывания
    public async Task PlayingStates()
    {
        isPlaying = !isPlaying;

        CheckState();
    }

    //Старт с начала
    public async Task StartOver()
    {
        isPlaying = true;

        await JS.InvokeVoidAsync("audioPlayer.startover", audioElement, 0);

        //
        //  todo - отслеживание загрузки аудио
        //
        await Task.Delay(100);

        trackLength = await JS.InvokeAsync<double>("audioPlayer.getlength", audioElement);
        Console.WriteLine(trackLength);

        CheckState();
    }

    //Перемотка
    public async Task Rewind(ChangeEventArgs e)
    {
        currentTimeStamp = Convert.ToInt32(e.Value);

        calculatedRewind = (currentTimeStamp / 1000) * trackLength;

        await JS.InvokeVoidAsync("audioPlayer.startover", audioElement, calculatedRewind);

        Console.WriteLine(currentTimeStamp);
    }

    public async Task CheckState()
    {
        switch (isPlaying)
        {
            case true:
                playPauseLabel = "⏸";

                timer.Start();

                await JS.InvokeVoidAsync("audioPlayer.play", audioElement);
                InvokeAsync(StateHasChanged);

                break;
            case false:
                playPauseLabel = "▶";

                timer.Stop();

                await JS.InvokeVoidAsync("audioPlayer.pause", audioElement);
                InvokeAsync(StateHasChanged);

                break;
        }
    }

    public async void TimerGetCurrentTimeStamp(Object source, System.Timers.ElapsedEventArgs e)
    {
        double rawSeconds = await JS.InvokeAsync<double>("audioPlayer.getcurrenttime", audioElement);

        if (trackLength > 0)
        {
            currentTimeStamp = (rawSeconds / trackLength) * 1000.0;
        }
        else
        {
            currentTimeStamp = 0;
        }

        await InvokeAsync(StateHasChanged);
    }
}